# =====================================================================
# SMART SECURITY MONITOR — EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT
# Ne jamais inscrire de véritables clés ou mots de passe dans ce modèle
# =====================================================================

# Environnement applicatif (production / development / test)
APP_ENV=production
IS_PRODUCTION=true

# Serveur & Sécurité Flask
SECRET_KEY=remplacez_par_une_cle_secrete_aleatoire_tres_longue_64_chars_min
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=7200

# Authentification & Comptes Initiaux
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=VotreMotDePasseFort2026!#Complexe

# Intégrité Cryptographique des Preuves (HMAC-SHA256)
# Minimum 16 octets (32 octets recommandés en production). Laissez vide pour mode unsealed (SHA-256 seul).
EVIDENCE_HMAC_KEY=cle_secrete_hmac_sha256_32_octets_minimale_production!!
INTEGRITY_SECRET_KEY=cle_secrete_hmac_sha256_32_octets_minimale_production!!

# Synchronisation Résiliente P2P / Edge (HMAC-SHA256)
# Minimum 32 octets requis en environnement de production.
P2P_CLUSTER_SECRET=cle_cluster_p2p_32_octets_minimale_obligatoire_prod!

# Chiffrement Judiciaire des Preuves & Privacy Shield (AES-256-GCM)
# Fichier contenant la clé binaire de 32 octets (généré avec permissions 0600)
PRIVACY_KEY_FILE=storage/keys/privacy_master.key
# Ou clé maître en hexadécimal (64 caractères hex = 32 octets)
PRIVACY_MASTER_KEY=

# Validation SSRF & Cibles Caméras
# N'autoriser le loopback (127.0.0.1) que pour les simulations locales en dev/test
ALLOW_LOOPBACK_SIMULATOR=false

# Notifications Telegram (Optionnel)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
TELEGRAM_TIMEOUT=5.0
TELEGRAM_MAX_RETRIES=3

# IA Visuelle xKiro (STRICTEMENT FREE TIER - AUCUN MODÈLE PAYANT)
XKIRO_VISION_ENABLED=true
XKIRO_API_KEY=votre_cle_api_xkiro_secrete
XKIRO_BASE_URL=https://api.xkiro.com/v1
# Laisser vide pour détection automatique du modèle Qwen Vision gratuit vérifié
XKIRO_VISION_MODEL=
XKIRO_VISION_TIMEOUT=8.0
XKIRO_VISION_MAX_REQUESTS_PER_MINUTE=10
XKIRO_VISION_MIN_INTERVAL=3.0
XKIRO_VISION_IMAGE_MAX_WIDTH=640
XKIRO_VISION_MAX_CONCURRENT_REQUESTS=1
XKIRO_VISION_FREE_TIER_ONLY=true
